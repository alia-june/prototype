  "title": "CastBundle",
  "description": "One 3D cast location plus aligned Plane 1/2/3 results.",
  "type": "object",
  "required": ["cast_id","frame_id","x","y","z","generation","transaction_id","activation_id","validation_epoch"],
  "properties": {

          "operation_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Operation Id",
            "type": "string"
          },
          "version": {
            "const": 1,
            "default": 1,
            "title": "Version",
            "type": "integer"
          },
          "kind": {
            "const": "set_style",
            "default": "set_style",
            "title": "Kind",
            "type": "string"
          },
          "property": {
            "enum": [
              "font_family",
              "font_size_mpt",
              "bold",
              "italic"
            ],
            "title": "Property",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "targets",
          "operation_id",
          "property",
          "value"
        ],
        "title": "SetStyle",
        "type": "object"
      },
      "Style": {
        "additionalProperties": false,
        "properties": {
          "font_family": {
            "anyOf": [
              {
                "maxLength": 256,
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Font Family"
          },
          "font_size_mpt": {
            "anyOf": [
              {
                "exclusiveMinimum": 0,
                "maximum": 2000000,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Font Size Mpt"
          },
          "bold": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Bold"
          },
          "italic": {
            "anyOf": [

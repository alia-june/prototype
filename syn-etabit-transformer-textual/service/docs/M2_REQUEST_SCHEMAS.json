            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Target",
            "type": "string"
          },
          "after": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_.:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "After"
          }
        },
        "required": [
          "operation_id",
          "target"
        ],
        "title": "MoveBlock",
        "type": "object"
      },
      "RemoveBlock": {
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Operation Id",
            "type": "string"
          },
          "version": {
            "const": 1,
            "default": 1,
            "title": "Version",
            "type": "integer"
          },
          "kind": {
            "const": "remove_block",
            "default": "remove_block",
            "title": "Kind",
            "type": "string"
          },
          "target": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Target",
            "type": "string"
          }
        },
        "required": [
          "operation_id",
          "target"
        ],
        "title": "RemoveBlock",
        "type": "object"
      },
      "ReplaceText": {
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Operation Id",
            "type": "string"
          },
          "version": {
            "const": 1,
            "default": 1,
            "title": "Version",
            "type": "integer"
          },
          "kind": {
            "const": "replace_text",
            "default": "replace_text",
            "title": "Kind",
            "type": "string"
          },
          "target": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Target",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "expected_text_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Expected Text Sha256",
            "type": "string"
          }
        },
        "required": [
          "operation_id",
          "target",
          "text",
          "expected_text_sha256"
        ],
        "title": "ReplaceText",
        "type": "object"
      },
      "RestoreFont": {
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Operation Id",
            "type": "string"
          },
          "version": {
            "const": 1,
            "default": 1,
            "title": "Version",
            "type": "integer"
          },
          "kind": {
            "const": "restore_font",
            "default": "restore_font",
            "title": "Kind",

        "default": null,
        "title": "Block Id"
      },
      "offset": {
        "default": 0,
        "minimum": 0,
        "title": "Offset",
        "type": "integer"
      },
      "limit": {
        "default": 50,
        "maximum": 100,
        "minimum": 1,
        "title": "Limit",
        "type": "integer"
      }
    },
    "required": [
      "target_id"
    ],
    "title": "InspectRequest",
    "type": "object"
  }

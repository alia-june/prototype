        "additionalProperties": false,
        "properties": {
          "targets": {
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            "title": "Targets",
            "type": "array"
          },
          "operation_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Operation Id",
            "type": "string"
          },
          "version": {
            "const": 1,
            "default": 1,
            "title": "Version",
            "type": "integer"
          },
          "kind": {
            "const": "restore_style",
            "default": "restore_style",
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "targets",
          "operation_id"
        ],
        "title": "RestoreStyle",
        "type": "object"
      },
      "SetFont": {
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Operation Id",
            "type": "string"
          },
          "version": {
            "const": 1,
            "default": 1,
            "title": "Version",
            "type": "integer"
          },
          "kind": {
            "const": "set_font",
            "default": "set_font",
            "title": "Kind",
            "type": "string"
          },
          "font_family": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Font Family",
            "type": "string"
          },
          "scope": {
            "const": "all_text",
            "default": "all_text",
            "title": "Scope",
            "type": "string"
          }
        },
        "required": [
          "operation_id",
          "font_family"
        ],
        "title": "SetFont",
        "type": "object"
      },
      "SetProperty": {
        "additionalProperties": false,
        "properties": {
